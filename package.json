{
  "name": "cleanframe",
  "version": "0.8.0",
  "private": true,
  "description": "CleanFrame TV launcher, Mac design editor and add-on host",
  "scripts": {
    "dev": "python3 scripts/preview.py",
    "check": "npm run lint && python3 scripts/check.py && npm run check:device",
    "package": "python3 scripts/package.py",
    "tv:info": "python3 scripts/tv.py info",
    "tv:install": "python3 scripts/tv.py install",
    "tv:launch": "python3 scripts/tv.py launch",
    "check:browser": "node scripts/check-browser.mjs",
    "dev:public": "python3 scripts/preview.py --public-fonts",
    "export:public": "python3 scripts/export-public.py",
    "check:public": "python3 scripts/check-public.py",
    "check:tools": "python3 -B scripts/test-tools.py",
    "lint": "eslint app",
    "check:device": "node --test scripts/test-device.mjs scripts/test-android-device.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "editor": "python3 scripts/editor_server.py --open",
    "check:editor": "node scripts/check-editor.mjs && node scripts/check-editor-workspace.mjs && node scripts/check-editor-import.mjs",
    "check:addons": "node scripts/check-addons-browser.mjs && node scripts/check-addon-setup.mjs",
    "check:editor:addons": "node scripts/check-editor-addons.mjs"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "eslint": "10.13.0",
    "interactjs": "1.10.28",
    "playwright": "1.64.1"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "cleanframe": {
    "androidVersionCode": 21
  }
}
